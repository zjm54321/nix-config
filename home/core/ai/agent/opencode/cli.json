{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "dark",
    "name": "one-dark"
  },
  "animations": true,
  "session": {
    "terminal": true,
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "new_location": "launch",
    "image_preview": true
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "attention": {
    "enabled": true
  },
  "terminal": {
    "title": true
  }
}
