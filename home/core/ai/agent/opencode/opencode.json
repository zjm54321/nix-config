{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "default_agent": "orchestrator",
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "title": {
      "model": {
        "providerID": "openrouter",
        "model": "openai/gpt-oss-20b"
      }
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": false
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "plugins": [
    "oh-my-opencode-slim@3.0.4",
    "opencode-todolist@0.5.0",
    "billion-context@0.1.194"
  ]
}
