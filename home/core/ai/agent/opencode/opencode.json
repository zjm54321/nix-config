{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "default_agent": "orchestrator",
  "disabled_providers": ["opencode"],
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "title": {
      "model": {
        "providerID": "openrouter",
        "model": "openai/gpt-oss-20b"
      }
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": false
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "$comment": "@honcho-ai/opencode-honcho@0.2.1 is disabled until per-agent memory isolation is available.",
  "plugins": [
    "oh-my-opencode-slim@3.0.4",
    "opencode-todolist@0.6.0",
    "billion-context@0.1.194",
    "opencode-clear-encrypted@0.1.2",
    "nix:model-policy",
    "nix:pty",
    "file:///home/ming/opencode-hermes-bridge/dist"
  ]
}
