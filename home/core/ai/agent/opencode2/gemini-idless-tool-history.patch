+// ID-less compatibility histories pair by position, so validate and order each
+// adjacent response batch by its original IDs before removing either side's IDs.
+const lowerIdlessToolHistory = (contents: GeminiBody["contents"]): Effect.Effect<GeminiBody["contents"], AIError> =>
+  Effect.gen(function* () {
+    const lowered: GeminiContent[] = []
+    let pending: Set<string> | undefined
+    for (const content of contents) {
+      const parts = content.parts ?? []
+      const calls = parts.filter((part) => "functionCall" in part)
+      const responses = parts.filter((part) => "functionResponse" in part)
+      if (pending) {
+        if (content.role !== "user" || calls.length > 0)
+          return yield* ProviderShared.invalidRequest("Gemini ID-less tool history requires an adjacent response batch")
+        const byId = new Map<string, Schema.Schema.Type<typeof GeminiFunctionResponsePart>>()
+        for (const part of responses) {
+          const id = part.functionResponse.id
+          if (!id || !pending.has(id) || byId.has(id))
+            return yield* ProviderShared.invalidRequest("Gemini ID-less tool history has a missing, unexpected, or duplicate response ID")
+          byId.set(id, part)
+        }
+        const ordered: Array<Schema.Schema.Type<typeof GeminiFunctionResponsePart>> = []
+        for (const id of pending) {
+          const part = byId.get(id)
+          if (!part)
+            return yield* ProviderShared.invalidRequest("Gemini ID-less tool history is missing a function response")
+          const functionResponse = { ...part.functionResponse }
+          delete functionResponse.id
+          ordered.push({ ...part, functionResponse })
+        }
+        let index = 0
+        lowered.push({
+          ...content,
+          parts: parts.map((part) => ("functionResponse" in part ? ordered[index++] : part)),
+        })
+        pending = undefined
+        continue
+      }
+      if (responses.length > 0)
+        return yield* ProviderShared.invalidRequest("Gemini ID-less tool history has an unexpected response batch")
+      if (calls.length === 0) {
+        lowered.push(content)
+        continue
+      }
+      if (content.role !== "model")
+        return yield* ProviderShared.invalidRequest("Gemini ID-less tool history requires model function calls")
+      pending = new Set()
+      for (const part of calls) {
+        const id = part.functionCall.id
+        if (!id || pending.has(id))
+          return yield* ProviderShared.invalidRequest("Gemini ID-less tool history has a missing or duplicate call ID")
+        pending.add(id)
+      }
+      lowered.push({
+        ...content,
+        parts: parts.map((part) => {
+          if (!("functionCall" in part)) return part
+          const functionCall = { ...part.functionCall }
+          delete functionCall.id
+          return { ...part, functionCall }
+        }),
+      })
+    }
+    if (pending)
+      return yield* ProviderShared.invalidRequest("Gemini ID-less tool history is missing a response batch")
+    return lowered
+  })
